# Copiez ces trois lignes dans Vercel > Settings > Environment Variables
# (jamais dans le code, jamais sur GitHub). Les vraies valeurs sont dans Supabase > Project Settings > API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# SECRÈTE : donne tous les pouvoirs sur la base. À ne jamais partager ni afficher.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Mot de passe de la synchronisation automatique des calendriers : une longue suite de caractères
# (24 minimum, 40 conseillés), la même dans Vercel et dans la planification Supabase (script 0004).
CRON_SECRET=une-longue-suite-de-caracteres-au-hasard
