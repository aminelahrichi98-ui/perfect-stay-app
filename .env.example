# Copiez ces trois lignes dans Vercel > Settings > Environment Variables
# (jamais dans le code, jamais sur GitHub). Les vraies valeurs sont dans Supabase > Project Settings > API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# SECRÈTE : donne tous les pouvoirs sur la base. À ne jamais partager ni afficher.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Mot de passe de la synchronisation automatique des calendriers : une longue suite de caractères
# (24 minimum, 40 conseillés), la même dans Vercel et dans la planification Supabase (script 0004).
CRON_SECRET=une-longue-suite-de-caracteres-au-hasard

# Phase 7 : réception automatique des leads Meta (voir le guide donné dans l'app / par Claude)
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# Demandes de Revenue Audit envoyées par le site vitrine (même valeur que LEAD_WEBHOOK_SECRET côté site)
SITE_LEADS_SECRET=

# Creative Intelligence : secret qui autorise Claude à lire les angles et à déposer une image
# (24 caractères au minimum). Sans lui, ce passage est fermé ; le dépôt manuel fonctionne toujours.
CREATIVE_IMPORT_SECRET=
